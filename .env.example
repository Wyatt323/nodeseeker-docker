# NodeSeeker Docker 环境变量配置模板
# 复制此文件为 .env 并修改相应的值

# ===========================================
# 服务器配置
# ===========================================
PORT=3010
HOST=0.0.0.0
NODE_ENV=production
# 允许的跨域源，多个用逗号分隔
CORS_ORIGINS=http://localhost:3010,https://your-domain.com

# ===========================================
# 数据库配置
# ===========================================
DATABASE_PATH=./data/nodeseeker.db

# ===========================================
# RSS 配置
# ===========================================
# RSS 请求超时（毫秒）
RSS_TIMEOUT=10000
# 是否启用 RSS 定时抓取
RSS_CHECK_ENABLED=true

# 注意：以下 RSS 配置已迁移到数据库，可在 Web 页面动态修改：
# - RSS 源地址（默认: https://rss.nodeseek.com/）
# - 抓取间隔秒数（默认: 60 秒）
# - HTTP/HTTPS 代理

# ===========================================
# Telegram 配置 (可选)
# ===========================================
# 多用户 Telegram 配置（管理员在网页 Telegram 设置中填写）
# 允许多个 ID，以逗号、空格或换行分隔。每个 ID 拥有独立关键词、暂停状态和推送记录。
# Bot Token 仍在网页中配置；推荐选择 Polling 模式，无需公网域名。

# Webhook URL 可选覆盖（优先级高于自动检测）
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook
# Webhook 模式强烈建议设置随机密钥；Telegram 回调必须携带该 secret token
# TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_value
